# Copy this file to .env and fill in what you have.
# Everything below is read defensively — features degrade gracefully
# (or print a "not configured" note) when a var is unset.

# --- Required for any LLM-calling step (Phase 1 Step 1 onward) ---
ANTHROPIC_API_KEY=

# --- Optional: LangSmith tracing (Phase 1 Step 4, and later graph tracing) ---
# When unset, the Step 4 script explains what you'd see instead of tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-devops-poc

# --- Optional: GitHub MCP (Phase 3 Step 8) ---
# Personal access token with repo:read scope on the repo you'll correlate
# deployments against.
GITHUB_TOKEN=
GITHUB_REPO=

# --- Optional: points at local infra (Phase 2/3) ---
ORDER_SERVICE_BASE_URL=http://localhost:8080
PROMETHEUS_BASE_URL=http://localhost:9090
ORDER_SERVICE_LOG_PATH=/tmp/order-service.log
# "Normal" p95 latency the observability MCP server compares against to
# decide HEALTHY vs DEGRADED (mcp-servers/observability-server).
BASELINE_LATENCY_MS=150
